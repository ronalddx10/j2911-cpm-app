# CPM Order Monitoring Application Environment Configuration

# PostgreSQL Connection String (Required)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/itadakimasu_db?schema=public

# Session / JWT Encryption Secret (Required, min 32 characters recommended)
JWT_SECRET=replace_with_a_secure_random_secret_string_32_chars_min
SESSION_SECRET=replace_with_a_secure_random_secret_string_32_chars_min

# Database SSL Configuration ('true' enables verified TLS; set to 'false' only for unencrypted local dev)
DB_SSL=true

# PDF Invoices / Storage Output Directory (Defaults to ./storage/invoices)
PDF_OUTPUT_DIR=./storage/invoices
